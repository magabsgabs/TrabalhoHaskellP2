      "item": [
        {
          "name": "Verificar Status da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/status"
          }
        },
        {
          "name": "Consultar CEP (ViaCEP)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/viacep/01001000"
          }
        }
      ]
    },
