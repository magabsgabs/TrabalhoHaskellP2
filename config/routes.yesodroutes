-- By default this file is used by `parseRoutesFile` in Foundation.hs
-- Syntax for this file here: https://www.yesodweb.com/book/routing-and-handlers

/static StaticR Static appStatic
/auth   AuthR   Auth   getAuth

/favicon.ico FaviconR GET
/robots.txt RobotsR GET

/ HomeR GET POST

/comments CommentR POST

/profile ProfileR GET

/categorias               CategoriasR   GET POST
/categorias/#CategoriaId  CategoriaR    GET PUT DELETE

/produtos                 ProdutosR     GET POST
/produtos/#ProdutoId      ProdutoR      GET PUT DELETE

/status                   StatusR       GET
/clientes                 ClientesR     GET POST
/clientes/#ClienteId      ClienteR      GET PUT DELETE
/viacep/#Text             ViaCepR       GET
/enderecos                EnderecosR    GET POST
/enderecos/#EnderecoId    EnderecoR     GET PUT DELETE


/fornecedores                   FornecedoresR   GET POST
/fornecedores/#FornecedorId     FornecedorR     GET PUT DELETE

/pedidos                        PedidosR        GET POST
/pedidos/#PedidoId              PedidoR         GET PUT DELETE

/itens-pedido                   ItensPedidoR    GET POST
/itens-pedido/#ItemPedidoId     ItemPedidoR     GET PUT DELETE
/clientes/#ClienteId/pedidos       ClientePedidosR     GET
/clientes/#ClienteId/enderecos     ClienteEnderecosR   GET
/categorias/#CategoriaId/produtos  CategoriaProdutosR  GET
/pedidos/#PedidoId/itens           PedidoItensR        GET
